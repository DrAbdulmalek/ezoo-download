# Maintainer: DrAbdulmalek <https://github.com/DrAbdulmalek>
# Contributor: Ezoo Download Linux port
#
# Build on Manjaro/Arch from this repo folder:
#   cd packaging && makepkg -si
#
# Or build the git version directly:
#   updpkgsums && makepkg -si   (after switching source to the -git form below)

pkgname=ezoo-download
pkgver=1.0.6
pkgrel=1
pkgdesc="Ezoo Download — fast download manager with video support (Rust + Slint, Linux port)"
arch=('x86_64')
url="https://github.com/DrAbdulmalek/ezoo-download"
license=('MIT')
# GUI/runtime: slint (winit) needs libxkbcommon/wayland/X11 libs, rfd file
# dialogs need gtk3, reqwest native-tls needs openssl, femtovg needs GL.
# Helpers: the port uses the SYSTEM yt-dlp/ffmpeg/aria2c from PATH.
depends=('gtk3' 'fontconfig' 'libxkbcommon' 'wayland' 'libglvnd' 'openssl'
         'yt-dlp' 'ffmpeg' 'aria2')
makedepends=('rust' 'base-devel')
source=("$pkgname-$pkgver.tar.gz::https://github.com/DrAbdulmalek/ezoo-download/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # TODO: replace with the real sha256 of the v$pkgver tag

# Git-source variant (always latest main):
# source=("git+https://github.com/DrAbdulmalek/ezoo-download.git")
# sha256sums=('SKIP')
# pkgver() {
#   cd "$srcdir/ezoo-download"
#   git describe --tags --long | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
# }

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_NET_OFFLINE=false
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/EzooDownload "$pkgdir/usr/bin/ezoo-download"
  install -Dm644 crates/app/ui/icon.png "$pkgdir/usr/share/pixmaps/ezoo-download.png"
  install -Dm644 packaging/ezoo-download.desktop \
    "$pkgdir/usr/share/applications/ezoo-download.desktop"
  install -Dm644 README-LINUX.md \
    "$pkgdir/usr/share/doc/ezoo-download/README-LINUX.md"
}
