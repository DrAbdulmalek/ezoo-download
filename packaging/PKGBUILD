# Maintainer: DrAbdulmalek <https://github.com/DrAbdulmalek>
# Contributor: Ezoo Download Linux port
#
# Build on Manjaro/Arch from a release tag (default):
#   cd packaging && makepkg -si
#
# Or build the latest main directly:
#   makepkg -si --noconfirm -o   # no; simplest git form:
#   switch to the -git source form below and run: makepkg -si

_tag="v1.0.7-linux"
pkgname=ezoo-download
pkgver=1.0.7
pkgrel=1
pkgdesc="Ezoo Download — fast download manager with video support (Rust + Slint, Linux port with tray)"
arch=('x86_64' 'aarch64')
url="https://github.com/DrAbdulmalek/ezoo-download"
license=('MIT')
# GUI/runtime: slint (winit) needs libxkbcommon/wayland/X11 libs (loaded at
# runtime), rfd file dialogs go through the XDG desktop portal (dbus), the
# tray is pure D-Bus (StatusNotifierItem/ksni — no GTK needed), femtovg
# needs GL. Helpers: the port uses the SYSTEM yt-dlp/ffmpeg/aria2 from PATH.
depends=('fontconfig' 'libxkbcommon' 'wayland' 'libglvnd' 'openssl'
         'yt-dlp' 'ffmpeg' 'aria2')
makedepends=('rust' 'base-devel')
source=("$pkgname-${_tag}.tar.gz::https://github.com/DrAbdulmalek/ezoo-download/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('be0e6af95af15f9d94333b36d2d050f1285af05e527568116df4e9d76db9fa71')

# Git-source variant (always latest main):
# source=("git+https://github.com/DrAbdulmalek/ezoo-download.git")
# sha256sums=('SKIP')
# pkgver() {
#   cd "$srcdir/ezoo-download"
#   git describe --tags --long | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
# }

build() {
  cd "$srcdir/$pkgname-1.0.7-linux"
  export CARGO_NET_OFFLINE=false
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname-1.0.7-linux"
  install -Dm755 target/release/EzooDownload "$pkgdir/usr/bin/ezoo-download"
  # freedesktop icon theme path (menus/desktop) + legacy pixmaps fallback
  install -Dm644 packaging/icon-256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/ezoo-download.png"
  install -Dm644 crates/app/ui/icon.png "$pkgdir/usr/share/pixmaps/ezoo-download.png"
  install -Dm644 packaging/ezoo-download.desktop \
    "$pkgdir/usr/share/applications/ezoo-download.desktop"
  install -Dm644 README-LINUX.md \
    "$pkgdir/usr/share/doc/ezoo-download/README-LINUX.md"
}
